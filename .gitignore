# Local-only material that must never be committed (see NOTES.md §14):
# film footage/frames/audio, SMPL/SMPL-X models, LaFAN1, AMASS, Mixamo,
# commercial sound libraries, model weights.
/private/

# Large downloaded source data (fetched by scripts, not committed)
/data/raw/
/data/vendor/

# Pipeline build outputs (rebuildable; large ones ship as release artifacts)
/data/build/
/data/cache/

# Media that should only ever come from /private/
*.mp4
*.mkv
*.webm
*.mov

# Arrays, meshes and photos/renders: fitted shapes, face deltas, landmarks, embeddings,
# reference crops and likeness renders are written as these (NOTES.md §14 rule 7).
# None is tracked; a deliberate public one needs `git add -f` (tools/hooks/pre-commit still
# refuses them under bench/).
*.npz
*.npy
*.obj
*.jpg
*.jpeg
*.exr

# Model files
*.pkl
*.ckpt
*.safetensors
*.pth
*.onnx

# Tooling
node_modules/
target/
dist/
.venv/
__pycache__/
*.blend1
.DS_Store

# Secrets (Freesound OAuth tokens, API keys)
.env
.env.*

# Claude Code agent worktrees
/.claude/worktrees/
